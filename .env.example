# URL base del API. Sin barra final.
VITE_API_BASE_URL=http://localhost:3000

# Login con Google. Debe ser el MISMO Client ID que el backend valida en
# GOOGLE_CLIENT_ID: es un OAuth Client ID de tipo "Aplicación web" en Google
# Cloud Console, con http://localhost:5173 (y el dominio real, en producción)
# en "Authorized JavaScript origins". Si se deja vacío, el botón de Google
# simplemente no aparece.
VITE_GOOGLE_CLIENT_ID=
