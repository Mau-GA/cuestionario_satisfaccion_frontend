# URL base de la API del backend
VITE_API_BASE_URL=http://localhost:3000

# (Opcional) Client ID de Google para el inicio de sesión con Google
# VITE_GOOGLE_CLIENT_ID=

# (Opcional) URL publica del front, la que se imprime en los codigos QR.
# Sin ella el QR apunta al origen desde el que se genero, que en desarrollo
# es localhost y no sirve fuera de esta maquina.
# VITE_PUBLIC_BASE_URL=https://encuestas.acatlan.unam.mx
